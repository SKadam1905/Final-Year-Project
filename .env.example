# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Every setting has a default; names in brackets are accepted as alternatives.

# Infrastructure (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=kumbh_dev_password
# If the database is unreachable or not migrated, the API keeps data in memory instead.
DATABASE_URL=postgresql+psycopg2://kumbh:kumbh_dev_password@localhost:5432/kumbhmela

# Frames: redis = bursts pushed by `python -m app.camera_manager` (needs Docker's Redis);
#         local = the API reads the cameras / video files itself (no Docker needed)
FRAME_SOURCE=redis

# Model and zones (paths relative to the repo root)
ZONES_CONFIG=config/zones.json
# [MODEL_PATH]
CSRNET_WEIGHTS=backend/ml/weights/csrnet_best.pth
# true only for the CSRNet authors' old .pth.tar checkpoint (a pickle: trusted files only)
CSRNET_ALLOW_PICKLE=false
DEVICE=auto
# CSRNet time per 720p frame on the RTX 2050 (AMP): 1280 -> 391 ms (5 cameras at 1 frame / 2 s),
# 960 -> 223 ms (8 cameras), 640 -> 108 ms. Smaller is faster but misses small, distant heads.
INFER_MAX_WIDTH=1280

# Pipeline (plan §3-§4)
BURST_SIZE=5
BURST_INTERVAL_S=2
ROLLING_WINDOW_S=30
# [ROLLING_WINDOW]
ROLLING_MAXLEN=15
PRESSURE_K=0.5
# [THRESHOLD_YELLOW / THRESHOLD_ORANGE / THRESHOLD_RED]
RISK_YELLOW=2.0
RISK_ORANGE=4.0
RISK_RED=6.0

# Alerts: console, sms (or twilio), telegram, all - comma-separated
ALERT_CHANNEL=console
# [ALERT_COOLDOWN_SECONDS]
ALERT_COOLDOWN_S=600

# Twilio SMS. Trial accounts can only text numbers verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# [SECURITY_PHONE_NUMBERS] Comma-separated, E.164 format, e.g. +919876543210
ALERT_SMS_TO=

# Telegram fallback: create a bot with @BotFather, message it once, then read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Browser origins allowed to call the API (comma-separated; * = any, for development)
CORS_ORIGINS=*
