# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Every setting has a default; names in brackets are accepted as alternatives.

# Infrastructure (Redis matches docker-compose.yml)
REDIS_URL=redis://localhost:6379/0
# MongoDB Atlas: Database > Connect > Drivers > Python, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=<cluster>
# [MONGO_URI] Empty or unreachable: readings, incidents and alerts are kept in memory instead.
MONGODB_URI=
MONGODB_DB=kumbhmela

# Frames: local (default) = the API reads the cameras / video files itself (no Docker needed);
#         redis = bursts pushed by `python -m app.camera_manager` (needs Docker's Redis)
FRAME_SOURCE=local

# Model and zones (paths relative to the repo root)
ZONES_CONFIG=config/zones.json
# [MODEL_PATH]
# show any weights file's provenance: cd backend; ..\venv\Scripts\python.exe -m tools.inspect_weights <file>
CSRNET_WEIGHTS=backend/ml/weights/csrnet_best.pth
# true only for the CSRNet authors' old .pth.tar checkpoint (a pickle: trusted files only)
CSRNET_ALLOW_PICKLE=false
DEVICE=auto
# CSRNet time per 720p frame on the RTX 2050 (AMP): 1280 -> 391 ms (5 cameras at 1 frame / 2 s),
# 960 -> 223 ms (8 cameras), 640 -> 108 ms. Smaller is faster but misses small, distant heads.
INFER_MAX_WIDTH=1280
# Optical flow (the CPU bottleneck) runs at this width; see results/flow_speed_vs_accuracy.md
FLOW_MAX_WIDTH=320
# frame = every moving pixel counts; density = flow weighted by the CSRNet density map (see README)
TURBULENCE_WEIGHTING=frame

# Hybrid count: YOLOv8 person detection (COCO-pretrained, person class) in sparse scenes, CSRNet otherwise.
# Download the weights once: cd backend; ..\venv\Scripts\python.exe -m tools.get_yolo_weights yolov8s
# off = CSRNet only. yolov8s: 19 ms per 640x360 frame on the RTX 2050 (results/yolo_benchmark.md)
YOLO_WEIGHTS=backend/ml/weights/yolo/yolov8s.pt
YOLO_IMGSZ=640
YOLO_CONF=0.25
# YOLO's count is used when the scene has fewer than HYBRID_THRESHOLD people.
# agree = CSRNet must also count fewer (YOLO misses small/hidden people in dense crowds); detector = YOLO alone decides
HYBRID_THRESHOLD=60
HYBRID_RULE=agree
# Zone-wise segmentation: people per cell of a GRID_ROWS x GRID_COLS grid over each camera view; the
# most crowded cell is the hotspot named in alerts
GRID_ROWS=3
GRID_COLS=3

# Pipeline (plan §3-§4)
BURST_SIZE=5
BURST_INTERVAL_S=2
ROLLING_WINDOW_S=30
# [ROLLING_WINDOW]
ROLLING_MAXLEN=15
PRESSURE_K=0.5
# [THRESHOLD_YELLOW / THRESHOLD_ORANGE / THRESHOLD_RED]
RISK_YELLOW=2.0
RISK_ORANGE=4.0
RISK_RED=6.0

# Alerts: console, telegram, all - comma-separated
ALERT_CHANNEL=console
# [ALERT_COOLDOWN_SECONDS]
ALERT_COOLDOWN_S=600

# Telegram: create a bot with @BotFather, send it /start once, then read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Browser origins allowed to call the API (comma-separated; * = any, for development)
CORS_ORIGINS=*

# Video analysis page: where uploads and results go (git-ignored), and the upload limit in MB
UPLOAD_DIR=data/uploads
VIDEO_MAX_MB=500
